
require('dotenv').config();

const express = require('express');
const cors = require('cors');
const OSS = require('ali-oss');
const multer = require('multer');
const fs = require('fs');
const os = require('os');
const path = require('path');
const crypto = require('crypto');

const app = express();
const PORT = Number(process.env.PORT || 3001);
const OSS_PREFIX = (process.env.OSS_PREFIX || 'spaces').replace(/^\/+|\/+$/g, '');

app.use(cors({
  // 正式部署时应替换成你的实际网页域名
  origin: process.env.FRONTEND_ORIGIN
    ? process.env.FRONTEND_ORIGIN.split(',').map(v => v.trim())
    : true
}));
app.use(express.json({ limit: '1mb' }));

const requiredEnv = [
  'OSS_REGION',
  'OSS_BUCKET',
  'OSS_ACCESS_KEY_ID',
  'OSS_ACCESS_KEY_SECRET'
];

const missing = requiredEnv.filter(key => !process.env[key]);
if (missing.length) {
  console.error('缺少环境变量：', missing.join(', '));
  process.exit(1);
}

const client = new OSS({
  region: process.env.OSS_REGION,
  bucket: process.env.OSS_BUCKET,
  accessKeyId: process.env.OSS_ACCESS_KEY_ID,
  accessKeySecret: process.env.OSS_ACCESS_KEY_SECRET,
  authorizationV4: true
});

// 上传先暂存到系统临时目录，不把文件永久保存在项目里
const upload = multer({
  dest: path.join(os.tmpdir(), 'shancheng-memory-uploads'),
  limits: {
    fileSize: 100 * 1024 * 1024,
    files: 6
  },
  fileFilter(req, file, cb) {
    const allowed = [
      'image/jpeg',
      'image/png',
      'image/webp',
      'video/mp4'
    ];

    if (!allowed.includes(file.mimetype)) {
      return cb(new Error('只支持 JPG、PNG、WebP 图片和 MP4 视频'));
    }
    cb(null, true);
  }
});

function validateNfcId(value) {
  // 允许 CQ-028、215 等 ID；禁止斜杠和路径穿越字符
  return typeof value === 'string'
    && /^[A-Za-z0-9_-]{1,64}$/.test(value);
}

function spacePrefix(nfcid) {
  return `${OSS_PREFIX}/${nfcid}/`;
}

function objectKey(nfcid, filename) {
  return `${spacePrefix(nfcid)}${filename}`;
}

function publicMediaItem(obj) {
  return {
    key: obj.name,
    name: obj.name.split('/').pop(),
    size: obj.size,
    lastModified: obj.lastModified,
    type: /\.(mp4)$/i.test(obj.name) ? 'video' : 'image',
    // 私有 Bucket 生成短时查看链接；链接过期后重新获取列表即可
    url: client.signatureUrl(obj.name, { expires: 1800 })
  };
}

// 健康检查
app.get('/api/health', (req, res) => {
  res.json({ ok: true, service: 'shancheng-memory-api' });
});

// 获取某个 NFC ID 的媒体列表
app.get('/api/spaces/:nfcid/media', async (req, res, next) => {
  try {
    const { nfcid } = req.params;
    if (!validateNfcId(nfcid)) {
      return res.status(400).json({ error: 'NFC ID 格式不正确' });
    }

    const prefix = spacePrefix(nfcid);
    const items = [];
    let marker;

    // 分页列举，避免空间媒体较多时只返回第一页
    do {
      const result = await client.list({
        prefix,
        'max-keys': 1000,
        ...(marker ? { marker } : {})
      });

      for (const obj of (result.objects || [])) {
        if (obj.name.endsWith('/')) continue;
        items.push(publicMediaItem(obj));
      }

      marker = result.isTruncated ? result.nextMarker : null;
    } while (marker);

    items.sort((a, b) =>
      new Date(b.lastModified || 0) - new Date(a.lastModified || 0)
    );

    res.json({ nfcid, items });
  } catch (err) {
    next(err);
  }
});

// 上传文件：POST multipart/form-data，字段名 files，可一次传多个
app.post(
  '/api/spaces/:nfcid/media',
  upload.array('files', 6),
  async (req, res, next) => {
    const files = req.files || [];
    const uploadedKeys = [];

    try {
      const { nfcid } = req.params;

      if (!validateNfcId(nfcid)) {
        return res.status(400).json({ error: 'NFC ID 格式不正确' });
      }
      if (!files.length) {
        return res.status(400).json({ error: '请选择要上传的文件' });
      }

      const results = [];

      for (const file of files) {
        const ext = path.extname(file.originalname).toLowerCase();
        const safeExt = {
          '.jpeg': '.jpg',
          '.jpg': '.jpg',
          '.png': '.png',
          '.webp': '.webp',
          '.mp4': '.mp4'
        }[ext];

        if (!safeExt) {
          throw new Error(`不支持的文件格式：${file.originalname}`);
        }

        const name = `${Date.now()}-${crypto.randomUUID()}${safeExt}`;
        const key = objectKey(nfcid, name);

        await client.put(key, file.path, {
          headers: { 'Content-Type': file.mimetype }
        });

        uploadedKeys.push(key);
        results.push({
          key,
          name,
          size: file.size,
          type: file.mimetype.startsWith('video/') ? 'video' : 'image',
          url: client.signatureUrl(key, { expires: 1800 })
        });
      }

      res.status(201).json({
        message: '上传成功',
        nfcid,
        items: results
      });
    } catch (err) {
      // 同一批上传中途失败时，尽量清理已成功上传的对象
      await Promise.allSettled(
        uploadedKeys.map(key => client.delete(key))
      );
      next(err);
    } finally {
      await Promise.allSettled(
        files.map(file => fs.promises.unlink(file.path))
      );
    }
  }
);

// 删除当前 NFC ID 目录内的单个文件
app.delete('/api/spaces/:nfcid/media', async (req, res, next) => {
  try {
    const { nfcid } = req.params;
    const { key } = req.body || {};

    if (!validateNfcId(nfcid)) {
      return res.status(400).json({ error: 'NFC ID 格式不正确' });
    }

    const prefix = spacePrefix(nfcid);

    // 必须是当前 NFC ID 的对象，拒绝其他目录的 key
    if (
      typeof key !== 'string'
      || !key.startsWith(prefix)
      || key.includes('..')
      || key.endsWith('/')
    ) {
      return res.status(400).json({ error: '文件路径无效或不属于当前空间' });
    }

    await client.delete(key);
    res.json({ message: '删除成功', key });
  } catch (err) {
    next(err);
  }
});

// 统一错误处理
app.use((err, req, res, next) => {
  console.error('[API Error]', err.message);

  if (err instanceof multer.MulterError) {
    const message = err.code === 'LIMIT_FILE_SIZE'
      ? '单个文件不能超过 100 MB'
      : err.code === 'LIMIT_FILE_COUNT'
        ? '一次最多上传 6 个文件'
        : '文件上传失败';

    return res.status(400).json({ error: message });
  }

  res.status(500).json({
    error: '服务器处理失败，请稍后重试'
  });
});

app.listen(PORT, () => {
  console.log(`山城拾光 API 已启动：http://localhost:${PORT}`);
});
